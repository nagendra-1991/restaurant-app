
pipeline {
    agent any

    options {
        timestamps()
    }

    environment {
        IMAGE_NAME = 'restaurant-app'
        CONTAINER_NAME = 'restaurant-app'
        APP_PORT = '8080'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build and Test') {
            steps {
                sh 'mvn -B clean test'
            }
        }

        stage('Package') {
            steps {
                sh 'mvn -B package -DskipTests'
                sh 'test -f target/restaurant-app.jar'
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t restaurant-app:latest .'
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    docker rm -f restaurant-app || true
                    docker run -d \
                      --name restaurant-app \
                      --restart unless-stopped \
                      -p 8080:8080 \
                      restaurant-app:latest
                '''
            }
	}
     }
}
