pipeline {
agent any

```
tools {
    jdk 'JDK17'
    maven 'Maven'
}

environment {
    IMAGE_NAME     = 'restaurant-app'
    CONTAINER_NAME = 'restaurant-app'
    APP_PORT       = '8080'
}

stages {
    stage('Checkout') {
        steps {
            git 
        }
    }

    stage('Build and Test') {
        steps {
            sh 'mvn -B clean test'
        }
    }

    stage('Package') {
        steps {
            sh 'mvn -B package -DskipTests'
            sh 'test -f target/restaurant-app.jar'
        }
    }

    stage('Build Docker Image') {
        steps {
            sh 'docker build -t ${IMAGE_NAME}:v.1.0 .'
        }
    }

    stage('Deploy') {
        steps {
            sh '''
                docker rm -f ${CONTAINER_NAME} || true

                docker run -d \
                  --name ${CONTAINER_NAME} \
                  --restart unless-stopped \
                  -p ${APP_PORT}:8080 \
                  ${IMAGE_NAME}:v.1.0
            '''
        }
    }
}
